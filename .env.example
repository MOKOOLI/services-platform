# ---- Backend ----
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
ADMIN_API_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_DEFAULT=qwen2.5:7b
OLLAMA_MODEL_LONG=qwen2.5:14b

APP_ENV=development                 # "production" on Render (disables the mock payment provider)
PUBLIC_API_URL=http://localhost:8000  # public URL of THIS api (payment gateway callback)

# ---- Payments: none | zarinpal | mock (mock = local dev only) ----
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# ---- File storage (S3-compatible). Local default = MinIO from docker-compose ----
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # what the BROWSER uses to upload/download
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MAX_UPLOAD_MB=25

# ---- Notifications (all optional; empty = disabled) ----
ADMIN_EMAIL=                        # contact-form messages are emailed here (needs RESEND_API_KEY)
PUBLIC_SITE_URL=http://localhost:3000
# Email via Resend (https://resend.com). Test sender only delivers to your own account email.
RESEND_API_KEY=
EMAIL_FROM=Services <onboarding@resend.dev>
# n8n webhook (production URL of the workflow; it must be Active)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/order-events
N8N_WEBHOOK_SECRET=change-me-another-random-string

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAX_UPLOAD_MB=25
NEXT_PUBLIC_SITE_NAME=افرا دانش سبز
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # canonical URL (sitemap, social previews)
# Public contact channels (all optional; empty = not shown anywhere on the site)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_TELEGRAM=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM=
# Optional: URL the Next.js *server* uses to reach the API (admin proxy). Defaults to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://backend:8000

# ---- Postgres (docker-compose) ----
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
