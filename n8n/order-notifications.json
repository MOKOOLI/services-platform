{
  "name": "Order notifications",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "order-events", "options": {} },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "order-events"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.headers['x-webhook-secret'] }}",
              "value2": "CHANGE_ME_SAME_AS_N8N_WEBHOOK_SECRET"
            }
          ]
        }
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "Check secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [260, 0]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.body.event === 'order.created' ? '🆕 سفارش جدید' : '🔄 تغییر وضعیت سفارش' }}\n{{ $json.body.order.product }}\nمشتری: {{ $json.body.order.customer_name }}\nکد: {{ $json.body.order.tracking_code }}\nوضعیت: {{ $json.body.order.status }}",
        "additionalFields": {}
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [520, -60]
    }
  ],
  "connections": {
    "Order Webhook": { "main": [[{ "node": "Check secret", "type": "main", "index": 0 }]] },
    "Check secret": { "main": [[{ "node": "Telegram", "type": "main", "index": 0 }], []] }
  },
  "active": false,
  "settings": {}
